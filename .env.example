# Database
DB_URL=postgresql://username:password@host:5432/sentultrip

# Admin auth session secret. Generate random value for production.
ADMIN_SESSION_SECRET=change_this_to_a_long_random_secret

# Google Analytics tracking tag
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-2JL1DK7QG6

# Google Analytics Data API
GA_PROPERTY_ID=542198406
GOOGLE_CLIENT_EMAIL=sentultrip@sentultrip.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# App base URL, used to build payment gateway callback URLs
NEXT_PUBLIC_APP_URL=https://sentultrip.com

# DOKU Checkout (get Client-Id and Secret Key from DOKU Back Office)
DOKU_CLIENT_ID=your_doku_client_id
DOKU_SECRET_KEY=your_doku_secret_key
DOKU_IS_PRODUCTION=false
NEXT_PUBLIC_DOKU_CHECKOUT_JS_URL=https://sandbox.doku.com/jokul-checkout-js/v1/jokul-checkout-1.0.0.js

# Midtrans Snap — legacy, being phased out in favor of DOKU above
MIDTRANS_SERVER_KEY=your_midtrans_server_key
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js
